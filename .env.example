# ============================================
# VakLab Outbound Agent Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# --------------------------------------------
# Google AI / Gemini Configuration
# --------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Set to 1 to use Vertex AI instead of Google AI API
# Requires GOOGLE_APPLICATION_CREDENTIALS to be set
GOOGLE_GENAI_USE_VERTEXAI=0

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# These match the docker-compose.yml postgres service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=outbound_agent_db
DB_USER=user
DB_PASSWORD=password

# --------------------------------------------
# Twilio Configuration
# --------------------------------------------
# Get these from: https://console.twilio.com/
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH=your_twilio_auth_token
TWILIO_NUMBER=+1234567890

# --------------------------------------------
# Domain Configuration
# --------------------------------------------
# For local dev with ngrok: https://your-subdomain.ngrok.io
# For production: https://your-domain.com
DOMAIN=https://your-ngrok-url.ngrok.io

# --------------------------------------------
# SMTP Configuration (for sending emails)
# --------------------------------------------
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# --------------------------------------------
# Application Environment
# --------------------------------------------
# Set to LOCAL for development, PROD for production
APP_ENVIRONMENT=LOCAL
