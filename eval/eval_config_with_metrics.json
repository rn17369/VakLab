{
  "criteria": {
    "hallucinations_v1": {
      "threshold": 0.8,
      "evaluate_intermediate_nl_responses": false
    },
    "safety_v1": 0.9,
    "rubric_based_final_response_quality_v1": {
      "threshold": 0.7,
      "judge_model_options": {
        "judge_model": "gemini-3-flash-preview",
        "num_samples": 3
      },
      "rubrics": [
        {
          "rubric_id": "warm_tone",
          "rubric_content": {
            "text_property": "The agent maintains a warm, encouraging, and friendly tone throughout the conversation."
          }
        },
        {
          "rubric_id": "concise_responses",
          "rubric_content": {
            "text_property": "The agent uses short, conversational sentences and avoids lengthy explanations."
          }
        },
        {
          "rubric_id": "no_jargon",
          "rubric_content": {
            "text_property": "The agent avoids medical jargon and uses simple, easy-to-understand language."
          }
        },
        {
          "rubric_id": "clear_value_prop",
          "rubric_content": {
            "text_property": "The agent clearly explains the benefits of the rewards program (gift cards, premium discounts, etc.)."
          }
        }
      ]
    },
    "rubric_based_tool_use_quality_v1": {
      "threshold": 0.8,
      "judge_model_options": {
        "judge_model": "gemini-3-flash-preview",
        "num_samples": 3
      },
      "rubrics": [
        {
          "rubric_id": "email_after_confirmation",
          "rubric_content": {
            "text_property": "The send_enrollment_email tool is only called after the user explicitly confirms they want to enroll and confirms their email address."
          }
        },
        {
          "rubric_id": "end_call_appropriate",
          "rubric_content": {
            "text_property": "The end_call tool is only called when the conversation is naturally complete, either after enrollment or when the user declines."
          }
        }
      ]
    }
  },
  "user_simulator_config": {
    "model": "gemini-3-flash-preview",
    "model_configuration": {
      "thinking_config": {
        "include_thoughts": true,
        "thinking_budget": 10240
      }
    },
    "max_allowed_invocations": 15
  }
}
